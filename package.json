{
  "name": "better-businesses",
  "version": "1.0.0",
  "private": true,
  "description": "Better Businesses \u2014 Canadian digital growth agency. Lead generation, SEO, website development and branding.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-db.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node scripts/prepare-db.mjs && prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/prepare-db.mjs && prisma migrate deploy",
    "db:seed": "node scripts/prepare-db.mjs && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/prepare-db.mjs && prisma generate",
    "db:prepare": "node scripts/prepare-db.mjs",
    "vercel-build": "node scripts/prepare-db.mjs && prisma generate && prisma db push --accept-data-loss --skip-generate && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
