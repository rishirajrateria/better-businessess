# ---- Database ----
# Local development (SQLite). For production use Postgres, see README "Deploying".
DATABASE_URL="file:./dev.db"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="https://betterbusinesses.ca"

# ---- Admin login (used by `npm run db:seed` to create the first admin) ----
ADMIN_EMAIL="info@betterbusinessess.com"
ADMIN_PASSWORD="Website@123"
# Random 32+ char string used to sign admin session cookies
AUTH_SECRET="replace-with-a-long-random-secret"

# ---- Optional: lead notification emails via Resend (https://resend.com) ----
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL="hello@betterbusinesses.ca"
LEAD_FROM_EMAIL="Better Businesses <leads@betterbusinesses.ca>"

# ---- Optional: Google Analytics 4 (first-party analytics is built in regardless) ----
NEXT_PUBLIC_GA_ID=""

# ---- Optional: Google Search Console verification token ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools verification (meta msvalidate.01). Bing's index powers ChatGPT search and Copilot.
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
# IndexNow key (optional). A stable key is derived from the domain when unset; served at /indexnow-key.txt.
INDEXNOW_KEY=""
# Set to 1 to keep only major cities (and all provinces) indexable; smaller city pages become noindex,follow.
NOINDEX_MINOR_CITIES=""
